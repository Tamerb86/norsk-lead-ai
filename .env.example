# ===== Required =====
VITE_APP_ID=norsk-lead-ai
# Must be 32+ random characters in production (enforced at startup).
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret for 2FA encryption + tracking-link signing (recommended; falls back to JWT_SECRET).
# Must also be 32+ random characters in production if set.
APP_SECRET=change-me-to-a-different-long-random-string

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== SendGrid =====
SENDGRID_API_KEY=
# Required in production for webhook security:
SENDGRID_WEBHOOK_VERIFICATION_KEY=

# ===== Lead follow-up agent (inbound replies) =====
# Domain whose MX record points at SendGrid Inbound Parse. Replies route to
# reply+{userId}-{leadId}-{token}@REPLY_DOMAIN and are matched back to the lead.
REPLY_DOMAIN=reply.nexifyhub.no
# Optional shared secret to gate the inbound webhook (?token=...). Defence in
# depth — the signed reply-address tag is the real authentication.
INBOUND_PARSE_TOKEN=

# ===== LLM (OpenAI / OpenAI-compatible) =====
OPENAI_API_KEY=
# Model used for chat completions (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Override to point at an OpenAI-compatible gateway (default: https://api.openai.com/v1)
OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Google Maps =====
# Server-side key (geocoding, places, etc.)
GOOGLE_MAPS_API_KEY=
# Client-side key (Maps JavaScript API in the browser)
VITE_GOOGLE_MAPS_API_KEY=

# ===== AWS S3 storage =====
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Notifications =====
# Optional outbound webhook. If unset, notifications are logged instead.
NOTIFICATION_WEBHOOK_URL=

# ===== Search / SERP (optional, generic) =====
SEARCH_API_URL=
SEARCH_API_KEY=

# ===== Optional =====
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OWNER_OPEN_ID=
SENTRY_DSN=
# Optional extra dev host allowed by Vite (e.g. a tunnel/preview domain)
VITE_ALLOWED_HOST=
